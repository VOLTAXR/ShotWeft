{
  "name": "shotweft",
  "version": "1.5.0",
  "private": true,
  "description": "Local-first storyboard and pre-production workspace for short films.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist/cli/",
    "docs/AGENT.md",
    "docs/MEDIA_SOURCES.md",
    "docs/RELEASE_NOTES_V1.5.md",
    "public/demo-media/*.jpg",
    "public/THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "check": "tsc --noEmit",
    "cli": "node dist/cli/shotweft.js",
    "dev": "vite --host 127.0.0.1",
    "director:demo": "node scripts/generate-director-demo.mjs",
    "prepack": "npm run build:cli",
    "preview": "vite preview --host 127.0.0.1",
    "release:checksums": "node scripts/release-checksum.mjs",
    "remotion:studio": "remotion studio remotion/index.ts --no-open",
    "report:agent": "node scripts/agent-report.mjs",
    "review:video": "node scripts/review-video.mjs",
    "test": "node scripts/test.mjs",
    "test:cli-m1": "node scripts/test-cli-m1.mjs",
    "test:director-m2": "node scripts/test-director-m2.mjs",
    "test:director-m3": "node scripts/test-director-m3.mjs",
    "test:director-m3-render": "node scripts/test-director-m3-render.mjs",
    "test:director-m4": "node scripts/test-director-m4.mjs",
    "test:director-project": "node scripts/test-director-project.mjs",
    "test:director-workspace": "node scripts/test-director-workspace.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:project-archive-transaction": "node scripts/test-project-archive-transaction.mjs",
    "test:remotion": "node scripts/test-remotion.mjs",
    "test:review-video": "node scripts/test-review-video.mjs",
    "test:video-render": "node scripts/test-video-render.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@zip.js/zip.js": "2.25.0",
    "d3-geo": "3.1.1",
    "dexie": "4.4.7",
    "flubber": "0.4.2",
    "konva": "10.10.0",
    "lucide-react": "1.77.0",
    "motion": "12.43.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.65.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-konva": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.546",
    "@remotion/cli": "4.0.546",
    "@remotion/player": "4.0.546",
    "@remotion/renderer": "4.0.546",
    "@types/d3-geo": "3.1.1",
    "@types/flubber": "0.4.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "remotion": "4.0.546",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "bin": {
    "shotweft": "dist/cli/shotweft.js"
  }
}
