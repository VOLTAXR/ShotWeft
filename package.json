{
  "name": "shotweft",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist/cli/",
    "docs/AGENT.md",
    "docs/MEDIA_SOURCES.md",
    "docs/RELEASE_NOTES_V1.5.md",
    "public/demo-media/*.jpg",
    "public/THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:cli",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "release:checksums": "node scripts/release-checksum.mjs",
    "report:agent": "node scripts/agent-report.mjs",
    "cli": "node dist/cli/shotweft.js",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "npm run build:cli"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@zip.js/zip.js": "2.25.0",
    "dexie": "4.4.7",
    "konva": "10.10.0",
    "lucide-react": "1.77.0",
    "motion": "12.43.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.65.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-konva": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "bin": {
    "shotweft": "dist/cli/shotweft.js"
  }
}
